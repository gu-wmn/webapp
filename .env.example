# Optional: set in shell to point at a different env file (default: ./.env)
# NEWME_ENV_FILE=/absolute/path/to/newme.env

# Core runtime
SECRET_KEY=change-me

# Accounts (email:password pairs, comma-separated)
# NEWME_USERS=user@example.com:password1,user2@example.com:password2

# Local default data dir (for `flask run` / local scripts).
# In Docker Compose this is set to /data by docker-compose.yml.
NEWME_DATA_PATH=./data

# Optional DB override:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/newme
# DATABASE_URL=sqlite:////absolute/path/to/newme-data/newme.sqlite3

# Installation controls
NEWME_INSTALL_CORPORA_ON_SETUP=true
NEWME_INSTALL_ANNOTATIONS_ON_SETUP=true
NEWME_CORPORA_ENABLED=bnc,winning-args-corpus,switchboard-corpus

# Optional annotations path overrides.
# If unset, the app auto-detects from:
# - ./wmn_annotations.json
# - legacy_src/newme.old/annotation/wmn_annotations.json
# - packaged newme/data/wmn_annotations.json
# NEWME_ANNOTATIONS_PATH=/absolute/path/to/wmn_annotations.json
# NEWME_CORPORA_ANNOTATIONS_PATH=/absolute/path/to/wmn_annotations.json

# Optional corpora filters/overrides
# NEWME_CORPORA_DIALOGUE_IDS=KCD,sw1234
# NEWME_CORPORA_CONFIG_PATH=/absolute/path/to/corpora-overrides.json
# NEWME_CORPORA_TIMEOUT_SECONDS=120
# NEWME_CORPORA_FORCE_REDOWNLOAD=false
